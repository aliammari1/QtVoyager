# QtVoyager database configuration
#
# Credentials are NEVER hardcoded in the source. They are resolved at runtime
# with the following precedence:
#   1. Environment variables (these keys)
#   2. QSettings (organization "QtVoyager", application "QtVoyager"):
#        db/driver, db/name, db/user, db/password
#   3. Built-in defaults (driver = QODBC; everything else empty)
#
# Copy this file to `.env` and fill in your own values, OR export these
# variables in your shell / launcher, OR set them via QSettings.
# Never commit a populated `.env`.

# Qt SQL driver to use (QODBC, QPSQL, QMYSQL, QSQLITE, ...).
QTVOYAGER_DB_DRIVER=QODBC

# ODBC DSN / database name.
QTVOYAGER_DB_NAME=YourDsnOrDatabaseName

# Database user.
QTVOYAGER_DB_USER=your_db_user

# Database password.
QTVOYAGER_DB_PASSWORD=your_db_password
